#: messages/roles.py:97
msgid "Some users don't exist, aborting"
msgstr "Några av användarna existerar inte, avbryter"

#: models.py:104
msgid "Make user active"
msgstr "Gör användaren aktiv"

#: models.py:114
msgid "Mark user as incomplete"
msgstr "Markera användaren som ofullständig"

#: rest_api/serializers.py:128
msgid "Meeting group doesn't exist"
msgstr "Gruppen existerar inte"

#: rest_api/serializers.py:135
msgid "You're not a member of this group"
msgstr "Du är inte medlem av den här gruppen"

#: rest_api/serializers.py:199
msgid "Email you specified isn't validated. It must exist on your profile."
msgstr ""
"Eposten du specificerade är inte validerad. Den måste finnas i din profil."

#: rest_api/serializers.py:416
msgid "You can only pick existing users within this meeting"
msgstr "Du kan bara välja existerande användare som är med i mötet"

#: rest_api/utils.py:55
msgid "Identity service not available right now"
msgstr "Identitetstjänsten är inte tillgänglig just nu"

#: rest_api/utils.py:62
msgid "You need to login again to use invites"
msgstr "Du behöver logga in igen för att använda inbjudningar"

#: rest_api/utils.py:76
#, python-format
msgid "You're missing the permission '%(perm)s' on %(obj)s."
msgstr "Du saknar behörigheten ’%(perm)s’ på %(obj)s."

#: rest_api/utils.py:130
msgid "Transition not specified"
msgstr "Handling måste anges"

#: rest_api/utils.py:135
#, python-format
msgid "Invalid transition: %(name)s"
msgstr "Ogiltig handling: %(name)s"

#: rest_api/utils.py:146
#, python-format
msgid "Can't switch from state '%(state)s' using method '%(method)s'"
msgstr "Kan inte byta från tillståndet ’%(state)s’ med metoden ’%(method)s’"

#: rest_api/utils.py:159
#, python-format
msgid "Guard %(guard)s blocks transition %(name)s"
msgstr "Regeln %(guard)s blockerar handlingen %(name)s"

#: rest_api/utils.py:222
msgid "Can't find meeting"
msgstr "Kan inte hitta mötet"

#: rest_api/validators.py:61
msgid ""
"This meeting group doesn't allow you to create posts in its name. "
"(post_as=False)"
msgstr "Denna mötesgrupp tillåter inte att du postar som den (post_as=False)"

#: rest_api/validators.py:71
msgid ""
"This meeting group doesn't allow you to display it together with your posts. "
"(post_with=False)"
msgstr ""
"Denna mötesgrupp tillåter inte att du postar med den. (post_with=False)"

