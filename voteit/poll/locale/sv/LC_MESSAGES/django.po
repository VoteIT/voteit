msgstr "Instant-Runoff Voting"

#: app/polls/irv.py:94 app/polls/irv.py:182
#, python-format
msgid "The method %(method)s require at least 3 proposals"
msgstr "Metoden %(method)s kräver minst 3 förslag"

#: app/polls/irv.py:156
